{
	"name": "dataflow2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "adf_dataflow_sink_dataset",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          id as integer,",
				"          firstName as string,",
				"          lastName as string,",
				"          age as integer,",
				"          gender as string,",
				"          email as string,",
				"          phone as string,",
				"          username as string,",
				"          password as string,",
				"          birthDate as string,",
				"          eyeColor as string,",
				"          height as integer,",
				"          weight as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1"
			]
		}
	}
}